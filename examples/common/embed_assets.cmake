# Turn a directory of web files into a C++ header, so a browser example is a
# single executable with no files to install beside it.
#
# Script mode, run at build time by wlonvif_embed_web_assets() in web_assets.cmake:
#
#   cmake -DOUTPUT=assets.hpp -DROOT=web -DNAMESPACE=a::b::assets
#         -DINPUTS="index.html|js/main.js" -P embed_assets.cmake
#
# INPUTS are paths relative to ROOT, separated by "|" (a ";" would split the
# command line). Each file becomes a byte array plus an entry in `files`, which
# the server looks up by request path.
set(content "#pragma once\n// Generated by embed_assets.cmake from ${ROOT}; edit those files instead.\n")
string(APPEND content "#include <string_view>\n\nnamespace ${NAMESPACE}\n{\n")
string(APPEND content "    struct File\n    {\n        std::string_view path; ///< Relative to the web directory, such as `js/main.js`.\n")
string(APPEND content "        std::string_view body;\n    };\n\n")

string(REPLACE "|" ";" INPUTS "${INPUTS}")
set(table "")
set(index 0)
foreach(path IN LISTS INPUTS)
  file(READ "${ROOT}/${path}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(LENGTH "${hex}" digits)
  math(EXPR size "${digits} / 2")
  string(APPEND content "    inline const unsigned char file_${index}[] = {${bytes}};\n")
  string(APPEND table "        {\"${path}\", {reinterpret_cast<const char*>(file_${index}), ${size}}},\n")
  math(EXPR index "${index} + 1")
endforeach()

string(APPEND content "\n    inline const File files[] = {\n${table}    };\n")
string(APPEND content "} // namespace ${NAMESPACE}\n")

# Rewrite only on change, so an unrelated reconfigure does not rebuild the server.
file(WRITE "${OUTPUT}.tmp" "${content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
