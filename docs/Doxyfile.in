PROJECT_NAME           = "wlonvif"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "C++20 ONVIF client and virtual-device library"
OUTPUT_DIRECTORY       = "@WLONVIF_DOXYGEN_OUTPUT_DIR@"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.dox" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/session-security.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/ptz-control.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/ptz-web.md"
FILE_PATTERNS          = *.h *.hpp *.dox *.md
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = "@WLONVIF_DOXYGEN_OUTPUT_DIR@/warnings.log"
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HTML_OUTPUT            = html
HTML_DYNAMIC_MENUS     = YES
HTML_COLORSTYLE        = DARK
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
USE_MDFILE_AS_MAINPAGE =
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
CLANG_ASSISTED_PARSING = NO
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"
QUIET                  = NO
